FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 QQQ_STREAM_DB=/data/qqq-stream-events.sqlite3
WORKDIR /app
COPY requirements-stream-monitor.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt && useradd --create-home --uid 10001 monitor
COPY research/qqq_stream_monitor.py /app/qqq_stream_monitor.py
RUN mkdir -p /data && chown -R monitor:monitor /app /data
USER monitor
VOLUME ["/data"]
CMD ["python", "/app/qqq_stream_monitor.py"]
